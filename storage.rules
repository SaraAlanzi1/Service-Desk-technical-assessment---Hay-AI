rules_version = '2';

// Milestone 2: ticket photo uploads. Scoped to the uploading tenant's own
// uid — the provider queue doesn't show photos yet, so read access is kept
// just as narrow as write for now; revisit when photo viewing is built for
// provider/admin.
service firebase.storage {
  match /b/{bucket}/o {
    match /ticketPhotos/{uid}/{ticketId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
